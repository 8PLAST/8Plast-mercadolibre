# Railway: volumen montado en /data. Mantener 0 hasta completar el traspaso.
APP_ENV=cloud
DATABASE_PATH=/data/8plast_stock.db
WEBHOOK_DATABASE_PATH=/data/8plast_stock.db
MELI_SYNC_ENABLED=0
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=https://DOMINIO-REAL/oauth/callback
MELI_TOKEN_KEY=
PORTAL_PASSWORD=
PORTAL_SECRET_KEY=

# MELI_TOKEN_KEY: Fernet.generate_key(); conservar la misma clave en redeploys.
# PORTAL_SECRET_KEY: valor aleatorio de al menos 32 caracteres.
# PORTAL_PASSWORD: contraseña de administrador de al menos 16 caracteres.
# PORT: Railway lo asigna. Start: python cloud_start.py
# No hay access/refresh tokens fijos en Variables: se autoriza desde /gestion.
