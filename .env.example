# El webhook no necesita estas credenciales para recibir y guardar notificaciones.
# Se usarán en la siguiente etapa, al consultar la orden real en la API.
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=

# Local: omitir para usar 8plast_stock.db en la carpeta principal.
# Render con disco persistente:
WEBHOOK_DATABASE_PATH=/var/data/8plast_stock.db
